# MySQL connection. Leave this as it is and `npm run db:start` replaces it with a
# private server on port 3307. To use your own server, put its address here,
# URL-encoding any special characters in the password.
DATABASE_URL="mysql://aicte:YOUR_PASSWORD@localhost:3306/aicte_fdr"

# Signs session cookies. At least 32 characters.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""

# AES-256 key for stored documents: exactly 64 hex characters.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Losing or changing this makes existing uploads unreadable.
FILE_ENCRYPTION_KEY=""

# Where encrypted files are written. Relative to the project root.
UPLOAD_DIR="uploads"

# Optional. When SMTP_HOST is empty, emails are logged to the console.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="AICTE FDR Portal <no-reply@example.test>"

# Turns on the audit tamper simulation in production. It is always on in development.
# Leave this off anywhere real: the simulation edits a stored audit entry.
ALLOW_TAMPER_SIMULATION="false"
